<?xml version="1.0"?>
<robot name="stack_box">
  <link name="box_root">
    <inertial><origin xyz="0 0 0"/><mass value="10"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
    <visual><geometry><box size="0.30 0.22 0.01"/></geometry><material name="box"><color rgba="0.72 0.72 0.72 1"/></material></visual>
    <collision><geometry><box size="0.30 0.22 0.01"/></geometry></collision>
  </link>
  <link name="wall_x0"><visual><geometry><box size="0.01 0.22 0.10"/></geometry><material name="box"/></visual></link>
  <link name="wall_x1"><visual><geometry><box size="0.01 0.22 0.10"/></geometry><material name="box"/></visual></link>
  <link name="wall_y0"><visual><geometry><box size="0.30 0.01 0.10"/></geometry><material name="box"/></visual></link>
  <link name="wall_y1"><visual><geometry><box size="0.30 0.01 0.10"/></geometry><material name="box"/></visual></link>
  <joint name="wall_x0_joint" type="fixed"><parent link="box_root"/><child link="wall_x0"/><origin xyz="-0.145 0 0.055"/></joint>
  <joint name="wall_x1_joint" type="fixed"><parent link="box_root"/><child link="wall_x1"/><origin xyz="0.145 0 0.055"/></joint>
  <joint name="wall_y0_joint" type="fixed"><parent link="box_root"/><child link="wall_y0"/><origin xyz="0 -0.105 0.055"/></joint>
  <joint name="wall_y1_joint" type="fixed"><parent link="box_root"/><child link="wall_y1"/><origin xyz="0 0.105 0.055"/></joint>
</robot>
